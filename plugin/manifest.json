{
  "$schema": "https://raw.githubusercontent.com/navidrome/navidrome/refs/heads/master/plugins/manifest-schema.json",
  "name": "CloudMusic Enhance",
  "author": "wujiaoxi",
  "version": "0.4.0",
  "description": "网易云音乐增强:智能评分匹配,补全歌词(含翻译合并)、专辑封面、专辑简介、歌手简介与头像",
  "website": "https://github.com/xyz9810010/navidrome-cloudmusic-plugin",
  "permissions": {
    "http": {
      "reason": "向网易云/QQ音乐请求搜索、歌词、封面与简介数据",
      "requiredHosts": [
        "music.163.com",
        "*.music.126.net",
        "c.y.qq.com",
        "*.gtimg.cn"
      ]
    },
    "kvstore": {
      "reason": "缓存歌词全文、歌手/专辑 ID 匹配结果与图片链接",
      "maxSize": "33554432"
    },
    "library": {
      "reason": "将歌词写成 .lrc 伴生文件,Navidrome 后续直接读文件、零网络请求",
      "filesystem": true
    }
  },
  "config": {
    "schema": {
      "type": "object",
      "properties": {
        "image_resolution": {
          "type": "string",
          "title": "封面分辨率 (网易云支持 200/300/500/800/1200)",
          "default": "1200"
        },
        "prefer_qq_cover": {
          "type": "boolean",
          "title": "封面优先用 QQ 音乐(无'博纳正版授权'水印),失败回退网易云",
          "default": true
        }
      }
    },
    "uiSchema": {
      "type": "VerticalLayout",
      "elements": [
        {
          "type": "Control",
          "scope": "#/properties/image_resolution"
        },
        {
          "type": "Control",
          "scope": "#/properties/prefer_qq_cover"
        }
      ]
    }
  }
}
